APP_NAME="Surya Path Astrology"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://suryapathkundli.com
ASSET_URL=https://suryapathkundli.com
APP_INSTALL=true
APP_MODE=live
APP_LOG_LEVEL=error

# MySQL Database (Docker Container: astrology-mysql)
DB_CONNECTION=mysql
DB_TIMEZONE="+05:30"
DB_HOST=astrology-mysql
DB_PORT=3306
DB_DATABASE=astrology_db
DB_USERNAME=dbadmin
DB_PASSWORD=DbAdmin@2026!

# Session, Cache & Queue via Redis (Docker Container: astrology-redis)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=astrology-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Broadcasting & Reverb WebSocket (Docker Container: astrology-reverb)
BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=astrology-app
REVERB_APP_KEY=astrology-key
REVERB_APP_SECRET=astrology-secret

REVERB_HOST=suryapathkundli.com
REVERB_PORT=443
REVERB_SCHEME=https

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=604800

# LiveKit SFU WebRTC (Docker Container: astrology-livekit on Host Network)
LIVEKIT_SERVER_URL=http://host.docker.internal:7880
LIVEKIT_WS_URL=wss://live.suryapathkundli.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=d8f1056b9524b66d2fdbe1c38e057138

# Coturn STUN / TURN NAT Traversal (Docker Container: astrology-coturn)
TURN_SERVER_URL=turn:turn.suryapathkundli.com:3478
TURN_SERVER_SECRET=livekit_secret_2024
TURN_SERVER_USERNAME=livekit
TURN_SERVER_CREDENTIAL=livekit_secret_2024
TURN_CREDENTIAL_TTL=86400

